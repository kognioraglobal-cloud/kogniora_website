# ============================================================
#  KOGNIORA WEBSITE — Environment Variables
#  Copy this file to .env.local and fill in your values.
#  NEVER commit .env.local to git.
# ============================================================

# Supabase — get these from:
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=YOUR_SUPABASE_URL
# e.g. https://abcdefghijkl.supabase.co

NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
# e.g. eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Vercel Deploy Hook URL (for auto-rebuild when courses are added)
# See DEPLOYMENT.md for setup instructions
# VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/...
